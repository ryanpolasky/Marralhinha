# Copy to .env and fill in. Never commit .env.

# Discord app (https://discord.com/developers/applications) -> OAuth2 page
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_SUPPORTER_SKU_ID=1554754882970587136

# Public URL of this server (used for the Discord OAuth redirect: <PUBLIC_URL>/api/auth/discord/callback)
PUBLIC_URL=https://marralhinha.app
# Only for local dev with the React dev server on :3000; leave commented out in production
# CLIENT_URL=http://localhost:3000

# Discord user ids (comma-separated) that get the Dev tag (admin) automatically when they log in.
# Without Discord, use `npm run tag -- <name or id> dev` instead.
# DEV_DISCORD_IDS=

# Optional
# PORT=3001
# DB_PATH=./data/marralhinha.db
DB_BACKUP_DIR=
# CLIENT_ORIGIN=https://your-frontend.example.com
