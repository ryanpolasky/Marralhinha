# Copy to .env and fill in. Never commit .env.

# Discord app (https://discord.com/developers/applications) -> OAuth2 page
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of this server (used for the Discord OAuth redirect: <PUBLIC_URL>/api/auth/discord/callback)
PUBLIC_URL=http://localhost:3001
# Where to send the browser after logging in. Only needed in dev when the React dev server runs separately.
CLIENT_URL=http://localhost:3000

# Optional
# PORT=3001
# DB_PATH=./data/marralhinha.db
# CLIENT_ORIGIN=https://your-frontend.example.com
